    <style>
        /* Reset & Base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'BNazanin', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0e1a 0%, #1a1f2f 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 2rem 1rem;
        }

        /* Card Container */
        .video-card {
            max-width: 1000px;
            width: 100%;
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 42px;
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.8), 0 10px 20px -6px rgba(0, 0, 0, 0.3);
            padding: 2rem 2rem 2.5rem;
            transition: all 0.3s ease;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* Header Section */
        .video-header {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.8rem;
            gap: 1rem;
        }

        .title-section {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .video-icon {
            background: linear-gradient(145deg, #e74c3c, #c0392b);
            color: white;
            width: 58px;
            height: 58px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            box-shadow: 0 10px 18px -8px rgba(231, 76, 60, 0.4);
            transition: 0.25s;
        }

        .title-text {
            font-size: 1.6rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.4px;
            line-height: 1.2;
            font-family: 'BNazanin', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .title-text small {
            display: block;
            font-size: 0.85rem;
            font-weight: 400;
            color: #aab4c9;
            opacity: 0.85;
            margin-top: 4px;
            letter-spacing: 0.2px;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 11px 24px;
            border-radius: 60px;
            font-weight: 600;
            font-size: 0.95rem;
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            transition: all 0.25s ease;
            cursor: pointer;
            text-decoration: none;
            backdrop-filter: blur(4px);
            font-family: 'BNazanin', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .btn-primary {
            background: linear-gradient(145deg, #e74c3c, #c0392b);
            color: white;
            border: none;
            box-shadow: 0 10px 20px -10px rgba(231, 76, 60, 0.5);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 16px 28px -12px rgba(231, 76, 60, 0.7);
        }

