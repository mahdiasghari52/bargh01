                مرورگر شما از نمایش ویدئو پشتیبانی نمی‌کند.
            </video>
        </div>

        <!-- Footer / Meta -->
        <div class="video-footer">
            <div class="file-info">
                <span><i class="far fa-file-video"></i> ۲۴ مگابایت</span>
                <span><i class="far fa-calendar-alt"></i> ۱۴۰۵/۰۵/۲۳</span>
                <span><i class="fas fa-play"></i> پخش آنلاین</span>
            </div>
            <div class="status-badge">
                <i class="fas fa-circle" style="font-size: 0.5rem;"></i> آماده پخش
            </div>
        </div>

    </div>

